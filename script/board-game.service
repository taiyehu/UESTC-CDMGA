[Unit]
Description=CDMGA Board Game Service
After=network-online.target webserver.service
Wants=network-online.target

[Service]
Type=simple
User=webserver
Group=webserver
WorkingDirectory=/opt/webserver/game-service/current
EnvironmentFile=/etc/webserver.env
Environment=NODE_ENV=production
Environment=GAME_HOST=127.0.0.1
Environment=GAME_PORT=3001
Environment=GAME_IDENTITY_URL=http://127.0.0.1:8080/api/identity/me
Environment=GAME_CONTENT_DIR=/var/webserver/game/current
ExecStart=/usr/bin/node /opt/webserver/game-service/current/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=board-game
MemoryMax=512M

[Install]
WantedBy=multi-user.target
